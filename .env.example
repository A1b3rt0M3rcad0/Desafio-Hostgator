# DESAFIO HOSTGATOR - LOCAL DEVELOPMENT
# Copy this file once before starting the stack:
#   cp .env.example .env
#   docker compose up --build -d
#
# All values below are development mocks. Replace every password and secret
# before using this project outside a local test environment.

# =============================================================================
# DOCKER COMPOSE - HOST PORTS
# =============================================================================
MYSQL_HOST_PORT=3306
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# =============================================================================
# DATABASE CONTAINER (db)
# =============================================================================
MYSQL_ROOT_PASSWORD=mock-local-mysql-password
MYSQL_DATABASE=desafio_hostgator

# =============================================================================
# MIGRATIONS CONTAINER (migrations)
# Docker Compose waits for the MySQL healthcheck before starting migrations.
# =============================================================================
MYSQL_URL_CONNECTION_MIGRATIONS=mysql+pymysql://root:mock-local-mysql-password@db:3306/desafio_hostgator

# =============================================================================
# API CONTAINER (api) - DATABASE
# SQL_ECHO=true logs generated SQL statements and should normally stay disabled.
# =============================================================================
MYSQL_URL_CONNECTION_API=mysql+aiomysql://root:mock-local-mysql-password@db:3306/desafio_hostgator
SQL_ECHO=false

# =============================================================================
# WORKER CONTAINER (worker)
# Every enabled cycle generates 30 records, atomically replaces tickets.json,
# reads that JSON and persists customers, tickets, tags and satisfaction data.
# The default mock customer pool contains 500 deterministic identities.
# =============================================================================
MYSQL_URL_CONNECTION_WORKER=mysql+aiomysql://root:mock-local-mysql-password@db:3306/desafio_hostgator
WORKER_SOURCE_PATH=/data/tickets.json
WORKER_BATCH_SIZE=30
WORKER_INTERVAL_SECONDS=30
WORKER_CONTROL_POLL_SECONDS=2
MOCK_CUSTOMER_COUNT=500
MOCK_START_TICKET_ID=100001
MOCK_YEAR=2026
MOCK_SEED=hostgator-challenge-v4

# =============================================================================
# API CONTAINER (api) - JWT AND SESSION
# =============================================================================
JWT_SECRET_KEY=mock-local-jwt-secret-key-not-for-production-2026
JWT_ALGORITHM=HS256
JWT_ISSUER=desafio-hostgator-api
JWT_AUDIENCE=desafio-hostgator-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_PEPPER=mock-local-refresh-token-pepper-not-for-production-2026
REFRESH_TOKEN_EXPIRE_DAYS=7

# =============================================================================
# API + WEB - PUBLIC REGISTRATION
# Keep enabled for local development. Use false in public deployments.
# =============================================================================
AUTH_REGISTRATION_ENABLED=true

# =============================================================================
# API CONTAINER (api) - CSRF AND PASSWORD HASHING
# =============================================================================
CSRF_SECRET_KEY=mock-local-csrf-secret-key-not-for-production-2026
CSRF_HEADER_NAME=X-CSRF-Token
BCRYPT_ROUNDS=12

# =============================================================================
# API CONTAINER (api) - AUTHENTICATION COOKIES
# =============================================================================
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_CSRF_COOKIE_NAME=csrf_token

# =============================================================================
# API CONTAINER (api) - BROWSER PERMISSIONS
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# WEB CONTAINER (web) - PUBLIC RUNTIME CONFIGURATION
# =============================================================================
WEB_APP_NAME=HostGator Analytics
WEB_APP_ENV=development
WEB_PUBLIC_URL=http://localhost:5173
WEB_API_URL=/api
WEB_API_UPSTREAM_URL=http://api:8000
WEB_SERVER_NAME=_
WEB_REQUEST_TIMEOUT_MS=15000
WEB_CSRF_COOKIE_NAME=csrf_token
WEB_CSRF_HEADER_NAME=X-CSRF-Token

# =============================================================================
# WEB DEVELOPMENT SERVER (npm run dev)
# =============================================================================
WEB_DEV_PORT=5173
WEB_DEV_API_UPSTREAM_URL=http://localhost:8000
