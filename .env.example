# Local Docker test environment.
# Copy once and start the stack:
#   cp .env.example .env
#   docker compose up --build -d
#
# Strict startup validation (optional):
#   docker compose up --build -d --wait --wait-timeout 120
#
# All credentials and secrets below are development mocks only.
# Replace them before using this configuration outside local tests.

MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=desafio_hostinger

# Docker Compose service DNS: the database hostname is "db".
MYSQL_URL_CONNECTION_API=mysql+aiomysql://root:change_me@db:3306/desafio_hostinger
MYSQL_URL_CONNECTION_MIGRATIONS=mysql+pymysql://root:change_me@db:3306/desafio_hostinger

# Authentication — development-only mock secrets, already valid for startup.
JWT_SECRET_KEY=dev-only-jwt-secret-key-2026-change-before-production-01
JWT_ALGORITHM=HS256
JWT_ISSUER=desafio-hostgator-api
JWT_AUDIENCE=desafio-hostgator-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_PEPPER=dev-only-refresh-token-pepper-2026-change-before-production-02
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET_KEY=dev-only-csrf-secret-key-2026-change-before-production-03
CSRF_HEADER_NAME=X-CSRF-Token
BCRYPT_ROUNDS=12

# Cookies and browser origins for local development.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_CSRF_COOKIE_NAME=csrf_token
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
