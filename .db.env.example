# Copy this file to .db.env and fill every required value.
# Start and wait for the complete stack with:
# docker compose --env-file .db.env up --build --wait --wait-timeout 120

MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=desafio_hostinger

MYSQL_URL_CONNECTION_API=mysql+aiomysql://root:change_me@db:3306/desafio_hostinger
MYSQL_URL_CONNECTION_MIGRATIONS=mysql+pymysql://root:change_me@db:3306/desafio_hostinger

# Authentication
# Each secret below must be a different random value with at least 32 characters.
# Empty values make Docker Compose fail before creating the containers.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ISSUER=desafio-hostgator-api
JWT_AUDIENCE=desafio-hostgator-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_PEPPER=
REFRESH_TOKEN_EXPIRE_DAYS=7
CSRF_SECRET_KEY=
CSRF_HEADER_NAME=X-CSRF-Token
BCRYPT_ROUNDS=12

# Cookies and browser origins (local development)
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_CSRF_COOKIE_NAME=csrf_token
CORS_ALLOWED_ORIGINS=http://localhost:5173
TRUSTED_ORIGINS=http://localhost:5173
