# PUBLIC WEB CONFIGURATION
# This file is loaded by the web container. Every value can be exposed to the browser;
# do not place passwords, tokens, private keys or backend secrets here.

# Name and environment displayed by the frontend.
WEB_APP_NAME=HostGator Analytics
WEB_APP_ENV=development

# Public origin where the browser accesses the frontend.
WEB_PUBLIC_URL=http://localhost:5173

# API URL used by browser requests.
# "/api" keeps browser and API on the same origin through the Nginx reverse proxy.
# An absolute URL such as http://localhost:8000 is also supported when CORS is configured.
WEB_API_URL=/api

# Internal Docker URL used only by Nginx to reach the API service.
# The hostname "api" is the Docker Compose service name and is not accessible from the browser.
WEB_API_UPSTREAM_URL=http://api:8000

# Port and API URL used only by `npm run dev`, where Vite runs outside Docker.
WEB_DEV_PORT=5173
WEB_DEV_API_UPSTREAM_URL=http://localhost:8000

# Nginx virtual-host name. "_" accepts any Host header in the local environment.
WEB_SERVER_NAME=_

# Maximum duration of a browser request before it is cancelled.
WEB_REQUEST_TIMEOUT_MS=15000

# Enables the public registration screen and route.
WEB_REGISTRATION_ENABLED=true

# Cookie/header names must match AUTH_CSRF_COOKIE_NAME and CSRF_HEADER_NAME from .env.
WEB_CSRF_COOKIE_NAME=csrf_token
WEB_CSRF_HEADER_NAME=X-CSRF-Token
