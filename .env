# LOCAL MOCK ENVIRONMENT
# This file is intentionally versioned so a fresh clone can run with:
#   docker compose up --build
# Values below are only for local development and must never be reused in production.

# Published host ports. Change only when the default port is already occupied.
MYSQL_HOST_PORT=3306
API_HOST_PORT=8000
WEB_HOST_PORT=5173

# MySQL database created by the db container.
MYSQL_ROOT_PASSWORD=mock-local-mysql-password
MYSQL_DATABASE=desafio_hostgator

# Internal Docker connection strings. The hostname "db" is the Compose service name.
MYSQL_URL_CONNECTION_API=mysql+aiomysql://root:mock-local-mysql-password@db:3306/desafio_hostgator
MYSQL_URL_CONNECTION_MIGRATIONS=mysql+pymysql://root:mock-local-mysql-password@db:3306/desafio_hostgator

# JWT access-token configuration. These mock secrets satisfy the API startup validation.
JWT_SECRET_KEY=mock-local-jwt-secret-key-not-for-production-2026
JWT_ALGORITHM=HS256
JWT_ISSUER=desafio-hostgator-api
JWT_AUDIENCE=desafio-hostgator-web
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15

# Refresh-session configuration. The pepper is used to hash refresh tokens before persistence.
REFRESH_TOKEN_PEPPER=mock-local-refresh-token-pepper-not-for-production-2026
REFRESH_TOKEN_EXPIRE_DAYS=7

# CSRF protection shared by the API and the browser client.
CSRF_SECRET_KEY=mock-local-csrf-secret-key-not-for-production-2026
CSRF_HEADER_NAME=X-CSRF-Token

# Password hashing cost. Twelve rounds are appropriate for the local challenge environment.
BCRYPT_ROUNDS=12

# Authentication cookies for local HTTP access.
# Production must use AUTH_COOKIE_SECURE=true and HTTPS.
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_DOMAIN=
AUTH_ACCESS_COOKIE_NAME=access_token
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_CSRF_COOKIE_NAME=csrf_token

# Browser origins authorized by the API.
# CORS controls cross-origin browser calls; TRUSTED_ORIGINS authorizes state-changing requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
