FROM node:22-alpine AS builder

WORKDIR /app
COPY web/package.json ./
RUN npm install --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM nginx:1.27-alpine
ENV NGINX_ENVSUBST_FILTER='^WEB_'
COPY web/docker/nginx.conf.template /etc/nginx/templates/default.conf.template
COPY web/docker/40-runtime-config.sh /docker-entrypoint.d/40-runtime-config.sh
COPY --from=builder /app/dist /usr/share/nginx/html
RUN chmod +x /docker-entrypoint.d/40-runtime-config.sh
EXPOSE 80
HEALTHCHECK --interval=10s --timeout=5s --start-period=10s --retries=5 CMD wget --quiet --tries=1 --spider http://127.0.0.1/health || exit 1
