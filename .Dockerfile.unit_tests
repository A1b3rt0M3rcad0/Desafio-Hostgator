FROM python:3.14-slim-bookworm

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH="/app/.venv/bin:$PATH" \
    UV_LINK_MODE=copy \
    COVERAGE_FILE=/tmp/.coverage \
    HOME=/tmp

WORKDIR /app

COPY --from=ghcr.io/astral-sh/uv:0.11.33 /uv /uvx /bin/

COPY pyproject.toml uv.lock ./
RUN uv sync --frozen --group dev

COPY src ./src
# The worker module imports the generator at module load time. Its code is a
# runtime dependency only; coverage remains explicitly restricted to src/.
COPY data ./data
COPY tests/unit ./tests/unit

RUN useradd --no-create-home --uid 10001 testuser \
    && mkdir -p /reports \
    && chown -R testuser:testuser /reports

USER testuser

CMD ["pytest", "tests/unit", "-m", "unit", "--cov=src", "--cov-branch", "--cov-report=term-missing", "--cov-report=xml:/reports/coverage-unit.xml", "--junitxml=/reports/junit-unit.xml", "--cov-fail-under=10", "-p", "no:cacheprovider"]
